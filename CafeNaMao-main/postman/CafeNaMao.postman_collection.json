  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Gera um identificador único por execução para evitar conflito entre rodadas.",
          "if (!pm.collectionVariables.get(\"bebida_teste_id\")) {",
          "    pm.collectionVariables.set(\"bebida_teste_id\", \"cafe-teste-\" + Date.now().toString(36));",
          "}"
        ]
      }
    }
  ],
