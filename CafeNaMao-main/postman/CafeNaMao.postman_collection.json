      "name": "Bebidas",
      "item": [
        {
          "name": "Listar bebidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 com JSON\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\");",
                  "});",
                  "",
                  "pm.test(\"Lista pelo menos as seis bebidas do catálogo\", function () {",
                  "    const bebidas = pm.response.json();",
                  "    pm.expect(bebidas).to.be.an(\"array\");",
                  "    pm.expect(bebidas.length).to.be.at.least(6);",
                  "    bebidas.forEach(function (bebida) {",
                  "        pm.expect(bebida).to.have.all.keys(\"id\", \"nome\", \"descricao\", \"categoria\", \"precoCentavos\");",
                  "        pm.expect(bebida.precoCentavos).to.be.a(\"number\");",
                  "        pm.expect(Number.isInteger(bebida.precoCentavos)).to.equal(true);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Inclui o cappuccino com preço em centavos\", function () {",
                  "    const cappuccino = pm.response.json().find(function (bebida) {",
                  "        return bebida.id === pm.collectionVariables.get(\"bebida_existente_id\");",
                  "    });",
                  "    pm.expect(cappuccino).to.not.be.undefined;",
                  "    pm.expect(cappuccino.precoCentavos).to.equal(750);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/bebidas"
          },
          "response": []
        },
