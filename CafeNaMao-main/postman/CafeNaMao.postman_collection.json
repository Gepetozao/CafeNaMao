    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido em dinheiro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 com número e Location\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.have.header(\"Location\");",
                  "    const pedido = pm.response.json();",
                  "    pm.expect(pedido.numero).to.match(/^PED-[A-Z0-9]{8}$/);",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(pedido.numero);",
                  "    pm.collectionVariables.set(\"pedido_numero\", pedido.numero);",
                  "});",
                  "",
                  "pm.test(\"Calcula subtotais e total em centavos\", function () {",
                  "    const pedido = pm.response.json();",
                  "    pm.expect(pedido.totalCentavos).to.equal(1900);",
                  "    pm.expect(pedido.itens).to.have.lengthOf(2);",
                  "    const cappuccino = pedido.itens.find(function (item) { return item.bebidaId === \"cappuccino\"; });",
                  "    const espresso = pedido.itens.find(function (item) { return item.bebidaId === \"espresso-curto\"; });",
                  "    pm.expect(cappuccino.quantidade).to.equal(2);",
                  "    pm.expect(cappuccino.precoCentavos).to.equal(750);",
                  "    pm.expect(cappuccino.subtotalCentavos).to.equal(1500);",
                  "    pm.expect(espresso.quantidade).to.equal(1);",
                  "    pm.expect(espresso.subtotalCentavos).to.equal(400);",
                  "});",
                  "",
                  "pm.test(\"Inicia com status recebido e pagamento em dinheiro\", function () {",
                  "    const pedido = pm.response.json();",
                  "    pm.expect(pedido.status).to.equal(\"recebido\");",
                  "    pm.expect(pedido.statusRotulo).to.equal(\"Recebido\");",
                  "    pm.expect(pedido.formaPagamento).to.equal(\"dinheiro\");",
                  "    pm.expect(pedido.formaPagamentoRotulo).to.equal(\"Dinheiro\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formaPagamento\": \"dinheiro\",\n  \"itens\": [\n    { \"bebidaId\": \"cappuccino\", \"quantidade\": 2 },\n    { \"bebidaId\": \"espresso-curto\", \"quantidade\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/pedidos"
          },
          "response": []
